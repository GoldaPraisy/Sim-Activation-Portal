# Local Development:
VITE_API_BASE_URL=http://localhost:5000/api

# Render.com Static Site Deployment:
# Set this Environment Variable in your Render Static Site settings:
# Key: VITE_API_BASE_URL
# Value: https://<your-backend-service-name>.onrender.com/api
#
# IMPORTANT: After setting/changing VITE_API_BASE_URL on Render,
# trigger a "Manual Deploy > Clear build cache & deploy" so Vite can compile it.
