# Server Port (Render sets $PORT automatically, defaults to 5000)
PORT=5000

# Environment Mode
NODE_ENV=production

# JWT Authentication Secret
JWT_SECRET=demo_esim_jwt_secret_key_super_secure_telecom_2026
JWT_EXPIRES_IN=7d

# Telecom SM-DP+ Simulation Server Domain
SMDP_SERVER=smdp.telecom-demo.io

# Simulated Carrier Delay (milliseconds)
MOCK_CARRIER_DELAY_MS=1000

# Enable Dev OTP in responses for testing
ENABLE_DEV_OTP=true
